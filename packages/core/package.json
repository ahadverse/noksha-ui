{
  "name": "@prism-ui/core",
  "version": "0.1.0",
  "description": "Prism UI headless primitives — accessibility, state and the pv() variant engine.",
  "license": "MIT",
  "author": "Ahad Hossain (https://github.com/ahadverse)",
  "homepage": "https://storewike.store/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahadverse/prism-ui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/ahadverse/prism-ui/issues"
  },
  "keywords": [
    "react",
    "headless",
    "accessibility",
    "primitives",
    "variants",
    "prism-ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
